{
  "version": 1,
  "items": {
    "catalog": {
      "kind": "skill",
      "scope": "user",
      "source": "self",
      "path": "skills/catalog",
      "description": "Drives catalog.sh: add, remove, update and check items from this index"
    },
    "web-images": {
      "kind": "skill",
      "scope": "project",
      "source": "self",
      "path": "skills/web-images",
      "description": "Image performance: sizing, srcset, formats, LCP, layout shift"
    },
    "expand-ebse": {
      "kind": "hook",
      "scope": "user",
      "source": "self",
      "path": "hooks/expand-ebse",
      "hook": {
        "event": "UserPromptSubmit",
        "script": "expand-ebse.sh"
      },
      "requires": [
        "jq"
      ],
      "description": "`ebse` → explain briefly in simple language and with examples"
    },
    "expand-wtru": {
      "kind": "hook",
      "scope": "user",
      "source": "self",
      "path": "hooks/expand-wtru",
      "hook": {
        "event": "UserPromptSubmit",
        "script": "expand-wtru.sh"
      },
      "requires": [
        "jq"
      ],
      "description": "`wtru` → walk through items one at a time"
    },
    "expand-exios": {
      "kind": "hook",
      "scope": "user",
      "source": "self",
      "path": "hooks/expand-exios",
      "hook": {
        "event": "UserPromptSubmit",
        "script": "expand-exios.sh"
      },
      "requires": [
        "jq"
      ],
      "description": "`exios` → explain in one sentence"
    },
    "expand-exi2s": {
      "kind": "hook",
      "scope": "user",
      "source": "self",
      "path": "hooks/expand-exi2s",
      "hook": {
        "event": "UserPromptSubmit",
        "script": "expand-exi2s.sh"
      },
      "requires": [
        "jq"
      ],
      "description": "`exi2s` → explain in two sentences"
    },
    "expand-ruview": {
      "kind": "hook",
      "scope": "user",
      "source": "self",
      "path": "hooks/expand-ruview",
      "hook": {
        "event": "UserPromptSubmit",
        "script": "expand-ruview.sh"
      },
      "requires": [
        "jq"
      ],
      "description": "`ruview` → file-review request"
    },
    "web-design-guidelines": {
      "kind": "skill",
      "scope": "project",
      "source": "vercel-agent-skills",
      "path": "skills/web-design-guidelines",
      "description": "Vercel: review UI code against web design guidelines"
    },
    "composition-patterns": {
      "kind": "skill",
      "scope": "project",
      "source": "vercel-agent-skills",
      "path": "skills/composition-patterns",
      "description": "Vercel: React composition patterns"
    },
    "react-view-transitions": {
      "kind": "skill",
      "scope": "project",
      "source": "vercel-agent-skills",
      "path": "skills/react-view-transitions",
      "description": "Vercel: React view transitions"
    },
    "agent-browser": {
      "kind": "skill",
      "scope": "project",
      "source": "agent-browser",
      "path": "skills/agent-browser",
      "requires": [
        "agent-browser-cli"
      ],
      "description": "Vercel: browser automation through the agent-browser CLI"
    },
    "modern-web-guidance": {
      "kind": "skill",
      "scope": "project",
      "source": "modern-web-guidance",
      "path": "skills/modern-web-guidance",
      "description": "Google Chrome: modern web platform best practices"
    },
    "chrome-extensions": {
      "kind": "skill",
      "scope": "project",
      "source": "modern-web-guidance",
      "path": "skills/chrome-extensions",
      "description": "Google Chrome: building and publishing Chrome extensions"
    },
    "superpowers": {
      "kind": "plugin",
      "scope": "user",
      "source": "superpowers",
      "description": "Process skills: brainstorming, TDD, planning, debugging"
    },
    "context7": {
      "kind": "plugin",
      "scope": "user",
      "source": "context7",
      "description": "Current library and framework docs (MCP)"
    },
    "millwright-inspector-development-machine": {
      "kind": "plugin",
      "scope": "user",
      "source": "millwright-inspector",
      "requires": [
        "plantuml-mcp-server"
      ],
      "description": "Millwright/inspector development workflow"
    },
    "vercel": {
      "kind": "plugin",
      "scope": "project",
      "source": "vercel-plugin",
      "description": "Vercel platform skills, agents and commands"
    },
    "figma": {
      "kind": "plugin",
      "scope": "project",
      "source": "figma",
      "description": "Figma MCP server and design-to-code skills"
    },
    "plantuml-mcp-server": {
      "kind": "tool",
      "scope": "user",
      "source": "plantuml-mcp-server",
      "bin": "plantuml-mcp-server",
      "install": "npm install -g plantuml-mcp-server@{version}",
      "description": "CLI behind millwright-inspector's plantuml MCP"
    },
    "agent-browser-cli": {
      "kind": "tool",
      "scope": "user",
      "source": "agent-browser-cli",
      "bin": "agent-browser",
      "install": "npm install -g agent-browser@{version} && agent-browser install",
      "description": "CLI behind the agent-browser skill"
    }
  },
  "bundles": {
    "personal": [
      "catalog",
      "expand-ebse",
      "expand-wtru",
      "expand-exios",
      "expand-exi2s",
      "expand-ruview",
      "superpowers",
      "context7",
      "millwright-inspector-development-machine"
    ],
    "web": [
      "web-images",
      "web-design-guidelines",
      "composition-patterns",
      "react-view-transitions",
      "modern-web-guidance",
      "agent-browser"
    ],
    "react": [
      "composition-patterns",
      "react-view-transitions"
    ],
    "vercel": [
      "vercel",
      "web-design-guidelines"
    ],
    "web-frontend": [
      "web-images",
      "web-design-guidelines",
      "composition-patterns",
      "react-view-transitions",
      "modern-web-guidance",
      "agent-browser",
      "vercel",
      "figma"
    ]
  }
}
